{
	"schemaVersion": 1,
	"id": "peripheral",
	"version": "${version}",
	"name": "Peripheral",
	"description": "Script Minecraft with Python. Expose game state over HTTP, run .py scripts with hotkeys, and optionally wire up an AI agent \u2014 all configurable through a clean in-game GUI.",
	"authors": [
		"Sl0oth"
	],
	"contact": {
		"modrinth": "https://modrinth.com/user/Sl0oth_"
	},
	"license": "CC0-1.0",
	"icon": "assets/peripheral/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"slooth.peripheral.PeripheralClient"
		],
		"modmenu": [
			"slooth.peripheral.PeripheralModMenuApi"
		]
	},
	"depends": {
		"fabricloader": ">=0.18.4",
		"minecraft": ">=26.1.2 <26.2",
		"java": ">=25",
		"fabric-api": "*"
	},
	"suggests": {
		"modmenu": "*",
		"baritone": "*"
	},
	"accessWidener": "peripheral.accesswidener"
}
