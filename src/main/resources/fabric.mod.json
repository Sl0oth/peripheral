{
	"schemaVersion": 1,
	"id": "peripheral",
	"version": "${version}",
	"name": "Peripheral",
	"description": "Script Minecraft with Python. Expose game state over HTTP, run .py scripts with hotkeys, and optionally wire up an AI agent — all configurable through a clean in-game GUI.",
	"authors": [
		"Sl0oth"
	],
	"contact": {
		"modrinth": "https://modrinth.com/user/Sl0oth_"
	},
	"license": "CC0-1.0",
	"icon": "assets/peripheral/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"slooth.peripheral.PeripheralClient"
		],
		"modmenu": [
			"slooth.peripheral.PeripheralModMenuApi"
		]
	},
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*",
		"panelib": ">=1.0.0-beta.3"
	},
	"suggests": {
		"modmenu": "*",
		"baritone": "*"
	},
	"accessWidener": "peripheral.accesswidener",
	"mixins": [
		{
			"config": "peripheral.client.mixins.json",
			"environment": "client"
		}
	]
}
